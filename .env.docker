# Docker Environment Template
# Copy this to .env and fill in your values

# WhatsApp Groups (comma-separated)
GROUPS=test,engineering,ops-alerts

# Gmail SMTP
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_TO=team@example.com
MAIL_CC=manager@example.com
MAIL_BCC=

# AI Summarization (Optional)
AI_ENABLED=true
AI_BASE_URL=http://host.docker.internal:20128/v1
AI_MODEL=omni
AI_API_KEY=sk-xxx

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Application
NODE_ENV=production
CONTEXT_MESSAGES=4
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Ticket Viewer (Optional)
VIEWER_PORT=3000

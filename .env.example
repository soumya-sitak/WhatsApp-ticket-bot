# Shared SMTP sender credentials and AI endpoint used by all bot instances.
# Copy this file to .env and replace the example values locally.

# AI / LLM (OpenAI-compatible API)
AI_ENABLED=true
AI_API_KEY=your-api-key-here
AI_BASE_URL=http://localhost:20128/v1
AI_MODEL=omni

# SMTP sender settings
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your-gmail-address@gmail.com
MAIL_PASS=your-app-specific-password

# Optional recipients copied to every account; per-account MAIL_TO is separate.
MAIL_CC=
MAIL_BCC=

# Shared ticket and bot behavior
BOT_PREFIX=[WA→Ticket]
BOT_COMMANDS=raise,/raise,!raise,ticket,/ticket,!ticket
BOT_CONTEXT_MESSAGES_COUNT=4
BOT_CONFIRM_IN_GROUP=true
BOT_IGNORE_OWN_MESSAGES=false
LOG_LEVEL=INFO
LOG_DIR=./logs
NODE_ENV=production
